# Für lokale Entwicklung: diese Datei nach `server/.env` kopieren (nichts anpassen nötig).
# Für den Server: nach `server/.env.production` kopieren und die drei Werte unten ausfüllen
# (siehe DEPLOYMENT.md, Abschnitt „Erstmaliges Einrichten“). NIEMALS committen.

NODE_ENV=development
PORT=3000

# Pflicht in Produktion. Erzeugen mit: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=90d

# Pflicht in Produktion. Bewusst AUSSERHALB des Repo-Ordners, damit `git pull` die
# Datenbank nie berührt, z. B. /var/lib/mathe-rakete/prod.sqlite
# In der Entwicklung leer lassen -> Standard ist server/data/dev.sqlite
DATABASE_PATH=
